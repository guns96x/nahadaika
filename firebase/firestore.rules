rules_version = '2';

// Чати Нагадайки в хмарі: спільні й особисті копії. Вхід — анонімний або через Google (Firebase Auth).
// Розгорнути: firebase deploy --only firestore:rules (або вставити в консолі Firebase → Firestore → Rules).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMember(chatId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
    }

    // Код запрошення дозволяє додати лише себе, а не підмінити назву чи інших учасників.
    function joining(chatId) {
      return !(request.auth.uid in resource.data.members)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'names', 'joinCode'])
        && request.resource.data.members.hasAll(resource.data.members)
        && request.resource.data.members.removeAll(resource.data.members) == [request.auth.uid]
        && request.resource.data.members.size() == resource.data.members.size() + 1
        && request.resource.data.names.diff(resource.data.names).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.names[request.auth.uid] is string
        && request.resource.data.joinCode == resource.data.inviteCode
        && get(/databases/$(database)/documents/invites/$(request.resource.data.joinCode)).data.chatId == chatId;
    }

    function memberUpdate() {
      return request.auth.uid in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'members', 'names', 'joinCode'])
        && request.resource.data.names.diff(resource.data.names).affectedKeys().hasOnly([request.auth.uid])
        && (
          request.resource.data.members == resource.data.members
          || (
            request.resource.data.members.removeAll(resource.data.members).size() == 0
            && resource.data.members.removeAll(request.resource.data.members) == [request.auth.uid]
            && request.resource.data.members.size() == resource.data.members.size() - 1
          )
        );
    }

    // Запрошення: прочитати можна лише за точним кодом (без переліку), створює — учасник чату.
    match /invites/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && isMember(request.resource.data.chatId);
      allow list, update, delete: if false;
    }

    // Запрошення на пошту Google-акаунта: бачить і прибирає лише адресат (за підтвердженою поштою з токена)
    // та той, хто запросив. Усередині — код чату, тож стороннім його не показуємо.
    match /mailInvites/{id} {
      function forMe() {
        return signedIn() && request.auth.token.email_verified == true
          && resource.data.email == request.auth.token.email.lower();
      }

      function mine() {
        return signedIn() && resource.data.createdBy == request.auth.uid;
      }

      function shapeOk() {
        return request.resource.data.keys().hasOnly(['email', 'chatId', 'chatName', 'code', 'fromName', 'createdBy', 'createdAt'])
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.email is string
          && request.resource.data.email == request.resource.data.email.lower()
          && request.resource.data.email.matches('[^@ ]+@[^@ ]+[.][^@ ]+')
          && request.resource.data.email.size() < 200
          && request.resource.data.chatName is string && request.resource.data.chatName.size() < 200
          && request.resource.data.fromName is string && request.resource.data.fromName.size() < 100
          && request.resource.data.code is string && request.resource.data.code.size() < 20
          && isMember(request.resource.data.chatId);
      }

      allow read: if forMe() || mine();
      allow create: if signedIn() && shapeOk();
      allow update: if mine() && shapeOk();
      allow delete: if forMe() || mine();
    }

    match /chats/{chatId} {
      allow create: if signedIn() && request.resource.data.members == [request.auth.uid]
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.names.keys().hasOnly([request.auth.uid])
        && request.resource.data.names[request.auth.uid] is string;
      // Останній учасник, виходячи, видаляє чат (особиста копія в хмарі).
      allow delete: if signedIn() && resource.data.members == [request.auth.uid];
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      // Учасник може перейменувати чат і вийти, але не додати сторонніх чи переписати чужі імена.
      allow update: if signedIn() && (memberUpdate() || joining(chatId));

      match /reminders/{reminderId} {
        allow read, delete: if isMember(chatId);
        allow create: if isMember(chatId) && request.resource.data.authorUid == request.auth.uid;
        allow update: if isMember(chatId) && request.resource.data.authorUid == resource.data.authorUid;
      }

      // Повідомлення пише лише сам автор і більше не змінює.
      match /comments/{commentId} {
        allow read: if isMember(chatId);
        allow create: if isMember(chatId) && request.resource.data.authorUid == request.auth.uid;
        allow update, delete: if false;
      }

      // FCM-токени телефонів учасників (документ {uid}_{пристрій}). Читають учасники — і сервер сповіщень
      // від імені того, хто надсилає; пише лише власник. Вийшовши з чату, власник може свій токен видалити.
      match /push/{device} {
        allow read: if isMember(chatId);
        allow create, update: if isMember(chatId)
          && device.matches(request.auth.uid + '_[A-Za-z0-9-]{8,40}')
          && request.resource.data.keys().hasOnly(['uid', 'token', 'updatedAt', 'app'])
          && (!('app' in request.resource.data) || request.resource.data.app is int)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.token is string
          && request.resource.data.token.size() < 500;
        allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      }

      // Медіа «кур'єром» (поки немає Storage): опис файлу {id.ext} і шматки до 900 КБ поруч — {id.ext}~{n}.
      // У всіх документів expireAt не далі 31 дня: прострочене (зокрема шматки без опису) прибирають телефони.
      match /media/{doc} {
        function isPart() {
          return doc.matches('[A-Za-z0-9_-]+[.](m4a|mp4|jpg|jpeg|png|webp)~([0-9]|[12][0-9]|3[01])');
        }

        function expiresSoon() {
          return request.resource.data.expireAt is timestamp
            && request.resource.data.expireAt < request.time + duration.value(31, 'd');
        }

        function partOk() {
          return request.resource.data.keys().hasOnly(['data', 'reminderId', 'expireAt'])
            && request.resource.data.data is bytes
            && request.resource.data.data.size() <= 950000
            && request.resource.data.reminderId is string
            && expiresSoon();
        }

        function metaOk() {
          return doc.matches('[A-Za-z0-9_-]+[.](m4a|mp4|jpg|jpeg|png|webp)')
            && request.resource.data.keys().hasOnly(['reminderId', 'uploader', 'size', 'mime', 'sha256', 'parts', 'receivedBy', 'createdAt', 'expireAt'])
            && request.resource.data.uploader == request.auth.uid
            && request.resource.data.reminderId is string
            && request.resource.data.size is int && request.resource.data.size > 0 && request.resource.data.size <= 26214400
            && request.resource.data.parts is int && request.resource.data.parts >= 1 && request.resource.data.parts <= 32
            && request.resource.data.receivedBy == []
            && expiresSoon();
        }

        // Отримувач лише додає себе до receivedBy.
        function receivedOk() {
          return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['receivedBy'])
            && request.resource.data.receivedBy.hasAll(resource.data.receivedBy)
            && request.resource.data.receivedBy.removeAll(resource.data.receivedBy) == [request.auth.uid];
        }

        allow read, delete: if isMember(chatId);
        allow create: if isMember(chatId) && ((isPart() && partOk()) || (!isPart() && metaOk()));
        allow update: if isMember(chatId) && ((isPart() && partOk()) || (!isPart() && receivedOk()));
      }
    }
  }
}
